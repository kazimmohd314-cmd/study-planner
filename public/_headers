# Cloudflare Pages / Static Hosting Caching Headers

# Prevent service worker and manifest caching on HTTP level so updates take effect immediately
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Immutable cache for Vite fingerprinted assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable
